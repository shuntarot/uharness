/// Two copies of `dut_top`, one on the board's DRAM (`d`) and one on host
/// memory (`h`). Over PCIe both reach memory through the card's one DMA
/// engine: the host's `load` / `memtest` into the DRAM, and the `h` copy's
/// host memory. `bringup.share.hio` runs them at the same time.
module share_top (
    i_clk: input clock,
    i_rst: input reset,

    // --- the copy on DRAM ---
    i_d_start       : input  logic,
    i_d_addr        : input  logic<64>,
    i_d_dst         : input  logic<64>,
    i_d_size        : input  logic<32>,
    o_d_busy        : output logic,
    o_d_done        : output logic,
    o_d_sum         : output logic<64>,
    o_d_beats       : output logic<32>,
    o_d_errors      : output logic<32>,
    o_d_cmd_valid   : output logic,
    i_d_cmd_ready   : input  logic,
    o_d_cmd_addr    : output logic<64>,
    o_d_cmd_size    : output logic<32>,
    i_d_rd_valid    : input  logic,
    o_d_rd_ready    : output logic,
    i_d_rd_data     : input  logic<64>,
    i_d_rd_last     : input  logic,
    i_d_rd_error    : input  logic,
    o_d_wcmd_valid  : output logic,
    i_d_wcmd_ready  : input  logic,
    o_d_wcmd_addr   : output logic<64>,
    o_d_wcmd_size   : output logic<32>,
    o_d_w_valid     : output logic,
    i_d_w_ready     : input  logic,
    o_d_w_data      : output logic<64>,
    o_d_w_last      : output logic,
    i_d_w_done      : input  logic,
    i_d_w_done_error: input  logic,

    // --- the copy on host memory ---
    i_h_start       : input  logic,
    i_h_addr        : input  logic<64>,
    i_h_dst         : input  logic<64>,
    i_h_size        : input  logic<32>,
    o_h_busy        : output logic,
    o_h_done        : output logic,
    o_h_sum         : output logic<64>,
    o_h_beats       : output logic<32>,
    o_h_errors      : output logic<32>,
    o_h_cmd_valid   : output logic,
    i_h_cmd_ready   : input  logic,
    o_h_cmd_addr    : output logic<64>,
    o_h_cmd_size    : output logic<32>,
    i_h_rd_valid    : input  logic,
    o_h_rd_ready    : output logic,
    i_h_rd_data     : input  logic<64>,
    i_h_rd_last     : input  logic,
    i_h_rd_error    : input  logic,
    o_h_wcmd_valid  : output logic,
    i_h_wcmd_ready  : input  logic,
    o_h_wcmd_addr   : output logic<64>,
    o_h_wcmd_size   : output logic<32>,
    o_h_w_valid     : output logic,
    i_h_w_ready     : input  logic,
    o_h_w_data      : output logic<64>,
    o_h_w_last      : output logic,
    i_h_w_done      : input  logic,
    i_h_w_done_error: input  logic,
) {
    inst u_d: dut_top (
        i_clk,
        i_rst,
        i_start       : i_d_start,
        i_addr        : i_d_addr,
        i_dst         : i_d_dst,
        i_size        : i_d_size,
        o_busy        : o_d_busy,
        o_done        : o_d_done,
        o_sum         : o_d_sum,
        o_beats       : o_d_beats,
        o_errors      : o_d_errors,
        o_cmd_valid   : o_d_cmd_valid,
        i_cmd_ready   : i_d_cmd_ready,
        o_cmd_addr    : o_d_cmd_addr,
        o_cmd_size    : o_d_cmd_size,
        i_rd_valid    : i_d_rd_valid,
        o_rd_ready    : o_d_rd_ready,
        i_rd_data     : i_d_rd_data,
        i_rd_last     : i_d_rd_last,
        i_rd_error    : i_d_rd_error,
        o_wcmd_valid  : o_d_wcmd_valid,
        i_wcmd_ready  : i_d_wcmd_ready,
        o_wcmd_addr   : o_d_wcmd_addr,
        o_wcmd_size   : o_d_wcmd_size,
        o_w_valid     : o_d_w_valid,
        i_w_ready     : i_d_w_ready,
        o_w_data      : o_d_w_data,
        o_w_last      : o_d_w_last,
        i_w_done      : i_d_w_done,
        i_w_done_error: i_d_w_done_error,
    );

    inst u_h: dut_top (
        i_clk,
        i_rst,
        i_start       : i_h_start,
        i_addr        : i_h_addr,
        i_dst         : i_h_dst,
        i_size        : i_h_size,
        o_busy        : o_h_busy,
        o_done        : o_h_done,
        o_sum         : o_h_sum,
        o_beats       : o_h_beats,
        o_errors      : o_h_errors,
        o_cmd_valid   : o_h_cmd_valid,
        i_cmd_ready   : i_h_cmd_ready,
        o_cmd_addr    : o_h_cmd_addr,
        o_cmd_size    : o_h_cmd_size,
        i_rd_valid    : i_h_rd_valid,
        o_rd_ready    : o_h_rd_ready,
        i_rd_data     : i_h_rd_data,
        i_rd_last     : i_h_rd_last,
        i_rd_error    : i_h_rd_error,
        o_wcmd_valid  : o_h_wcmd_valid,
        i_wcmd_ready  : i_h_wcmd_ready,
        o_wcmd_addr   : o_h_wcmd_addr,
        o_wcmd_size   : o_h_wcmd_size,
        o_w_valid     : o_h_w_valid,
        i_w_ready     : i_h_w_ready,
        o_w_data      : o_h_w_data,
        o_w_last      : o_h_w_last,
        i_w_done      : i_h_w_done,
        i_w_done_error: i_h_w_done_error,
    );
}
