/// A DUT that **uses every backing at once**. It is the only piece here that
/// carries `reg`, `slave`, `bram`, `host_poll_fifo` and a heartbeat together,
/// so it is the only one on which `load`, `memtest` and `drain` can be tried
/// on hardware.
///
/// Every input is driven from a CSR, so on hardware each feature can be
/// exercised by writing a register and reading a register -- nothing else.
///
/// **Board-independent.** Which board it is built for is decided by
/// `gen --target`.
module dut_top (
    i_clk: input clock,
    i_rst: input reset,

    // --- driven by the host (reg) ---
    i_addr : input logic<16> , // memory address (byte-addressed)
    i_en   : input logic     , // read enable
    i_wen  : input logic     , // line write
    i_wdata: input logic<128>, // the line to write (4 words)
    i_wstrb: input logic<16> , // byte strobes
    i_push : input logic     , // one beat into the FIFO

    // --- observed by the host (reg) ---
    o_read : output logic<32>, // the word read back from memory
    o_wide : output logic<64>, // a multi-word register (2 words)

    // --- memory (bram: line writes, word reads) ---
    o_mem_addr : output logic<16> ,
    o_mem_en   : output logic     ,
    i_mem_rdata: input  logic<32> ,
    o_mem_wdata: output logic<128>,
    o_mem_wstrb: output logic<16> ,
    o_mem_wen   : output logic    ,

    // --- stream (host_poll_fifo: valid_only, so entries are dropped) ---
    o_tx_valid: output logic    ,
    o_tx_data : output logic<64>,

    // --- a register file the DUT owns (slave: the host is the master) ---
    // The data lives here, not in the harness. The harness opens a window
    // onto it; `addr` being an input is what says so.
    i_csr_addr : input  logic<4> ,
    i_csr_wdata: input  logic<32>,
    i_csr_we   : input  logic    ,
    o_csr_rdata: output logic<32>,
) {
    // 16 words the host can read and write, and the DUT can use. Reading is
    // one cycle, which is what `latency = 1` in the manifest states.
    var csr: logic<32> [16];

    always_ff {
        if i_csr_we {
            csr[i_csr_addr] = i_csr_wdata;
        }
        o_csr_rdata = csr[i_csr_addr];
    }

    var count: logic<64>;

    always_ff {
        if_reset {
            o_read = 0;
            count  = 0;
        } else {
            o_read = i_mem_rdata;
            if i_push {
                count = count + 1;
            }
        }
    }

    assign o_wide = 64'hfeed_face_dead_beef;

    assign o_mem_addr  = i_addr;
    assign o_mem_en    = i_en;
    assign o_mem_wdata = i_wdata;
    assign o_mem_wstrb = i_wstrb;
    assign o_mem_wen   = i_wen;

    // valid_only: ready is never looked at, so a full FIFO drops the beat.
    assign o_tx_valid = i_push;
    assign o_tx_data  = count;
}
