/// The smallest DUT there is, for checking on hardware that a target
/// description still works.
///
/// **Use something already known to be correct rather than writing one** --
/// this is nothing but `std::fifo` wrapped with no parameters. If this does
/// not run, **the fault is in the target description or in the harness**,
/// and nowhere else. (Same reasoning, and the same manifest, as the
/// reference DUT in `tests/targets.rs`.)
///
/// **Board-independent.** Which board it is built for is decided by
/// `gen --target`.
module dut_top (
    i_clk  : input  clock   ,
    i_rst  : input  reset   ,
    i_push : input  logic   ,
    i_data : input  logic<8>,
    o_full : output logic   ,
    i_pop  : input  logic   ,
    o_data : output logic<8>,
    o_empty: output logic   ,
) {
    inst u: $std::fifo #(
        WIDTH: 8 ,
        DEPTH: 16,
    ) (
        i_clk            ,
        i_rst            ,
        i_clear      : 0 ,
        o_empty          ,
        o_almost_full: _ ,
        o_full           ,
        o_word_count : _ ,
        i_push           ,
        i_data           ,
        i_pop            ,
        o_data           ,
    );
}
