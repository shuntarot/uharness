/// `hns::axi_mem` returns what was written over AXI4, and the backdoor sees the
/// same data.
///
/// The stand-in keeps the same port and only replaces where the data lives.
/// So the key check is that the AXI4 side and the host side see one memory.
#[test(axi_mem_roundtrip)]
module test_axi_mem {
    const DEPTH: u32 = 16;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    inst bus: $std::axi4_if::<$std::axi4_pkg::<32, 4, 4, 1, 1, 1, 1, 1>>;

    var haddr : logic<4> ;
    var hwdata: logic<32>;
    var hwstrb: logic<4> ;
    var hwe   : logic    ;
    var hrdata: logic<32>;

    inst u: axi_mem::<$std::axi4_pkg::<32, 4, 4, 1, 1, 1, 1, 1>> #(
        DEPTH: DEPTH,
    ) (
        i_clk   : clk   ,
        i_rst   : rst   ,
        axi     : bus   ,
        i_haddr : haddr ,
        i_hwdata: hwdata,
        i_hwstrb: hwstrb,
        i_hwe   : hwe   ,
        o_hrdata: hrdata,
    );

    /// Writes one beat. `addr` is a byte address.
    ///
    /// Each valid drops as soon as its ready is seen. In AXI4, a valid that stays
    /// high after the handshake starts the next transfer. Holding it until
    /// bvalid would make the same write happen twice.
    function put (
        addr: input logic<32>,
        data: input logic<32>,
    ) {
        bus.awaddr  = addr;
        bus.awlen   = 0;
        bus.awid    = 1;
        bus.awvalid = 1;
        bus.wdata   = data;
        bus.wstrb   = 4'hf;
        bus.wlast   = 1;
        bus.wvalid  = 1;
        for _i in 0..16 {
            if bus.awready {
                break;
            }
            clk.next(1);
        }
        clk.next(1);
        bus.awvalid = 0;
        for _i in 0..16 {
            if bus.wready {
                break;
            }
            clk.next(1);
        }
        clk.next(1);
        bus.wvalid = 0;
        for _i in 0..16 {
            if bus.bvalid {
                break;
            }
            clk.next(1);
        }
        clk.next(1);
    }

    function get (
        addr: input logic<32>,
    ) -> logic<32> {
        bus.araddr  = addr;
        bus.arlen   = 0;
        bus.arid    = 2;
        bus.arvalid = 1;
        for _i in 0..16 {
            if bus.arready {
                break;
            }
            clk.next(1);
        }
        clk.next(1);
        bus.arvalid = 0;
        for _i in 0..16 {
            if bus.rvalid {
                break;
            }
            clk.next(1);
        }
        return bus.rdata;
    }

    // The other master signals. The stand-in ignores them, but they must not
    // be left undriven.
    always_comb {
        bus.awsize   = 3'd2;
        bus.awburst  = 2'b01;
        bus.awcache  = 0;
        bus.awprot   = 0;
        bus.awlock   = 0;
        bus.awqos    = 0;
        bus.awregion = 0;
        bus.awuser   = 0;
        bus.wuser    = 0;
        bus.arsize   = 3'd2;
        bus.arburst  = 2'b01;
        bus.arcache  = 0;
        bus.arprot   = 0;
        bus.arlock   = 0;
        bus.arqos    = 0;
        bus.arregion = 0;
        bus.aruser   = 0;
    }

    initial {
        bus.awvalid = 0;
        bus.wvalid  = 0;
        bus.arvalid = 0;
        bus.bready  = 1;
        bus.rready  = 1;
        hwe         = 0;
        hwstrb      = 4'hf;
        haddr       = 0;
        rst.assert(4);
        clk.next(4);

        // Write and read over AXI4.
        put(32'h0, 32'hcafe_0000);
        put(32'h4, 32'hcafe_0001);
        $display("axi: [0]=%h [1]=%h", get(32'h0), get(32'h4));
        $assert(get(32'h0) == 32'hcafe_0000);
        $assert(get(32'h4) == 32'hcafe_0001);

        // The backdoor sees the same data. This is the main point of the stand-in.
        haddr = 1;
        clk.next(2);
        $display("backdoor: [1]=%h", hrdata);
        $assert(hrdata == 32'hcafe_0001);

        // A backdoor write is visible over AXI4.
        haddr  = 2;
        hwdata = 32'hbeef_0002;
        hwe    = 1;
        clk.next(1);
        hwe = 0;
        clk.next(2);
        $assert(get(32'h8) == 32'hbeef_0002);

        clk.next(4);
        $finish();
    }
}
