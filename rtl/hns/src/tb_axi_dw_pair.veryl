/// `hns::axi_dw` connects a 256-bit master to a 512-bit memory.
///
/// The ratio is 2. The other tests use ratios 4 and 16. The PCIe DMA engines
/// (`hns::dma_wr` / `hns::dma_rd`) have a bus of this width, and their traffic
/// goes through this conversion behind the controller.
///
/// One wide beat holds only two narrow beats, so at most one beat waits to be
/// packed. A bug at the boundary loses only that one beat. It shows up as data
/// shifted by 32 bytes, which is hard to find.
#[test(axi_dw_packs_two_to_one)]
module test_axi_dw_pair {
    const DEPTH: u32 = 16; // 16 words of 512 bits = 1024 bytes

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen (
        clk: clk,
    );

    inst nar: $std::axi4_if::<$std::axi4_pkg::<32, 32, 4, 1, 1, 1, 1, 1>>;
    inst wid: $std::axi4_if::<$std::axi4_pkg::<32, 64, 4, 1, 1, 1, 1, 1>>;

    inst u_dw: axi_dw::<$std::axi4_pkg::<32, 32, 4, 1, 1, 1, 1, 1>, $std::axi4_pkg::<32, 64, 4, 1, 1, 1, 1, 1>> (
        i_clk: clk,
        i_rst: rst,
        s_axi: nar,
        m_axi: wid,
    );

    inst u_mem: axi_mem::<$std::axi4_pkg::<32, 64, 4, 1, 1, 1, 1, 1>> #(
        DEPTH: DEPTH,
    ) (
        i_clk   : clk,
        i_rst   : rst,
        axi     : wid,
        i_haddr : '0 ,
        i_hwdata: '0 ,
        i_hwstrb: '0 ,
        i_hwe   : '0 ,
        o_hrdata: _  ,
    );

    always_comb {
        nar.awsize   = 3'd5; // 32 bytes = the full master width
        nar.awburst  = 2'b01;
        nar.awcache  = 0;
        nar.awprot   = 0;
        nar.awlock   = 0;
        nar.awqos    = 0;
        nar.awregion = 0;
        nar.awuser   = 0;
        nar.wuser    = 0;
        nar.arsize   = 3'd5;
        nar.arburst  = 2'b01;
        nar.arcache  = 0;
        nar.arprot   = 0;
        nar.arlock   = 0;
        nar.arqos    = 0;
        nar.arregion = 0;
        nar.aruser   = 0;
    }

    /// The data of beat `n`. The number is spread over all lanes. A check of
    /// only the first 4 of the 32 bytes would miss swapped lanes.
    function beat (
        n: input logic<32>,
    ) -> logic<256> {
        return {n + 7, n + 6, n + 5, n + 4, n + 3, n + 2, n + 1, n};
    }

    /// Writes a burst of `len+1` beats at `addr`. Beat `i` is `beat(seed + i)`.
    function put (
        addr: input logic<32>,
        len : input logic<8> ,
        seed: input logic<32>,
    ) {
        nar.awaddr  = addr;
        nar.awlen   = len;
        nar.awid    = 3;
        nar.awvalid = 1;
        for _i in 0..64 {
            if nar.awready {
                break;
            }
            clk.next(1);
        }
        clk.next(1);
        nar.awvalid = 0;

        for i in 0..32 {
            if i >: len {
                break;
            }
            nar.wdata  = beat(seed + i);
            nar.wstrb  = '1;
            nar.wlast  = if i == len ? 1 : 0;
            nar.wvalid = 1;
            for _j in 0..64 {
                if nar.wready {
                    break;
                }
                clk.next(1);
            }
            clk.next(1);
        }
        nar.wvalid = 0;

        for _i in 0..64 {
            if nar.bvalid {
                break;
            }
            clk.next(1);
        }
        $assert(nar.bvalid);
        nar.bready = 1;
        clk.next(1);
        nar.bready = 0;
    }

    /// Reads a burst of `len+1` beats and checks that beat `i` is `beat(seed + i)`.
    function check (
        addr: input logic<32>,
        len : input logic<8> ,
        seed: input logic<32>,
    ) {
        nar.araddr  = addr;
        nar.arlen   = len;
        nar.arid    = 4;
        nar.arvalid = 1;
        for _i in 0..64 {
            if nar.arready {
                break;
            }
            clk.next(1);
        }
        clk.next(1);
        nar.arvalid = 0;

        for i in 0..32 {
            if i >: len {
                break;
            }
            for _j in 0..64 {
                if nar.rvalid {
                    break;
                }
                clk.next(1);
            }
            $assert(nar.rvalid);
            $assert(nar.rlast == (if i == len ? 1 : 0));
            if nar.rdata != beat(seed + i) {
                $display("  MISMATCH at beat %d: got %h want %h", i, nar.rdata, beat(seed + i));
            }
            $assert(nar.rdata == beat(seed + i));
            nar.rready = 1;
            clk.next(1);
            nar.rready = 0;
        }
    }

    /// Writes two bursts in a row, and sends W of the second before its AW.
    ///
    /// AXI4 allows a master to send W before AW, and the PCIe read DMA engine
    /// does so. It sends W each time a completion arrives, so the next data
    /// is waiting while the previous burst waits for B.
    ///
    /// The invariant under test: `wready` must stay low while no burst is open.
    /// Otherwise the beat enters the packing stage of the finished burst and is
    /// lost silently. On real hardware this showed up as a 32-byte shift.
    function put_pair (
        addr0: input logic<32>,
        addr1: input logic<32>,
        len  : input logic<8> ,
        seed0: input logic<32>,
        seed1: input logic<32>,
    ) {
        // Burst 0. Do not wait for B here. Waiting would skip the window where
        // the bug happens (between wlast and B).
        nar.awaddr  = addr0;
        nar.awlen   = len;
        nar.awid    = 3;
        nar.awvalid = 1;
        for _i in 0..64 {
            if nar.awready {
                break;
            }
            clk.next(1);
        }
        clk.next(1);
        nar.awvalid = 0;

        for i in 0..32 {
            if i >: len {
                break;
            }
            nar.wdata  = beat(seed0 + i);
            nar.wstrb  = '1;
            nar.wlast  = if i == len ? 1 : 0;
            nar.wvalid = 1;
            for _j in 0..64 {
                if nar.wready {
                    break;
                }
                clk.next(1);
            }
            clk.next(1);
        }

        // Send the first beat of the next burst before its AW.
        nar.wdata  = beat(seed1);
        nar.wstrb  = '1;
        nar.wlast  = if len == 0 ? 1 : 0;
        nar.wvalid = 1;
        for _j in 0..8 {
            $assert(!nar.wready);
            clk.next(1);
        }

        nar.awaddr  = addr1;
        nar.awlen   = len;
        nar.awid    = 3;
        nar.awvalid = 1;
        for _i in 0..64 {
            if nar.awready {
                break;
            }
            clk.next(1);
        }
        clk.next(1);
        nar.awvalid = 0;

        for i in 0..32 {
            if i >: len {
                break;
            }
            nar.wdata  = beat(seed1 + i);
            nar.wstrb  = '1;
            nar.wlast  = if i == len ? 1 : 0;
            nar.wvalid = 1;
            for _j in 0..64 {
                if nar.wready {
                    break;
                }
                clk.next(1);
            }
            clk.next(1);
        }
        nar.wvalid = 0;

        for _i in 0..64 {
            if nar.bvalid {
                break;
            }
            clk.next(1);
        }
        $assert(nar.bvalid);
        nar.bready = 1;
        clk.next(1);
        nar.bready = 0;
    }

    initial {
        nar.awvalid = 0;
        nar.wvalid  = 0;
        nar.arvalid = 0;
        nar.bready  = 0;
        nar.rready  = 0;
        rst.assert(4);
        clk.next(4);

        // Exactly one wide beat (2 narrow beats, aligned).
        put(32'h000, 1, 32'h1000);
        check(32'h000, 1, 32'h1000);

        // Single beat. It writes half of a wide beat.
        put(32'h040, 0, 32'h2000);
        check(32'h040, 0, 32'h2000);

        // Odd count (3 beats). The last wide beat is partial.
        put(32'h080, 2, 32'h3000);
        check(32'h080, 2, 32'h3000);

        // Starts in the upper half of a wide beat (0x0e0 = lane 1). Both ends
        // are partial.
        put(32'h0e0, 2, 32'h4000);
        check(32'h0e0, 2, 32'h4000);

        // Long burst. On real hardware, failures started at 512 bytes
        // (16 narrow beats).
        put(32'h180, 15, 32'h5000);
        check(32'h180, 15, 32'h5000);

        // The earlier writes are still there.
        check(32'h000, 1, 32'h1000);
        check(32'h0e0, 2, 32'h4000);

        // A master whose W comes before AW. If the packing stage of the
        // finished burst takes the beat, the data is shifted by 32 bytes here.
        put_pair(32'h200, 32'h280, 3, 32'h6000, 32'h7000);
        check(32'h200, 3, 32'h6000);
        check(32'h280, 3, 32'h7000);
        $display("width conversion (2:1): packed, ragged, offset, long and early-W bursts all match");

        clk.next(4);
        $finish();
    }
}
