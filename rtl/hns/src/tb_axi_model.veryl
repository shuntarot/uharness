/// `hns::axi_model`: a read answers the read latency after its address, a
/// write the write latency after its data, reads in flight overlap instead
/// of queueing one behind another, and the bandwidth limit spaces the beats.
/// The data never changes.
#[test(axi_model_sets_the_latency_and_rate)]
module test_axi_model {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    inst bus : $std::axi4_if::<$std::axi4_pkg::<32, 4, 4, 1, 1, 1, 1, 1>>;
    inst mbus: $std::axi4_if::<$std::axi4_pkg::<32, 4, 4, 1, 1, 1, 1, 1>>;

    var rd_latency: logic<16>;
    var wr_latency: logic<16>;
    var bw        : logic<16>;
    var rd_beats  : logic<32>;
    var wr_beats  : logic<32>;

    inst m: axi_model::<$std::axi4_pkg::<32, 4, 4, 1, 1, 1, 1, 1>> #(
        DEPTH : 8 ,
        RBEATS: 16,
    ) (
        i_clk       : clk       ,
        i_rst       : rst       ,
        i_rd_latency: rd_latency,
        i_wr_latency: wr_latency,
        i_bw        : bw        ,
        o_rd_beats  : rd_beats  ,
        o_wr_beats  : wr_beats  ,
        s_axi       : bus       ,
        m_axi       : mbus      ,
    );

    inst u: axi_mem::<$std::axi4_pkg::<32, 4, 4, 1, 1, 1, 1, 1>> #(
        DEPTH: 16,
    ) (
        i_clk   : clk ,
        i_rst   : rst ,
        axi     : mbus,
        i_haddr : 0   ,
        i_hwdata: 0   ,
        i_hwstrb: 0   ,
        i_hwe   : 0   ,
        o_hrdata: _   ,
    );

    var ticks: logic<32>;

    always_ff (clk, rst) {
        if_reset {
            ticks = 0;
        } else {
            ticks = ticks + 1;
        }
    }

    var waited: logic<32>;

    /// Writes one beat; `waited` is the cycles from the W handshake to B.
    function put (
        addr: input logic<32>,
        data: input logic<32>,
    ) {
        var from       : logic<32>;
        bus.awaddr  = addr;
        bus.awvalid = 1;
        for _i in 0..600 {
            if bus.awready {
                break;
            }
            clk.next(1);
        }
        clk.next(1);
        bus.awvalid = 0;
        bus.wdata   = data;
        bus.wvalid  = 1;
        for _i in 0..600 {
            if bus.wready {
                break;
            }
            clk.next(1);
        }
        from = ticks;
        clk.next(1);
        bus.wvalid = 0;
        for _i in 0..600 {
            if bus.bvalid {
                break;
            }
            clk.next(1);
        }
        waited = ticks - from;
        clk.next(1);
    }

    /// Reads one beat; `waited` is the cycles from the AR handshake to R.
    function get (
        addr: input logic<32>,
    ) -> logic<32> {
        var data       : logic<32>;
        var from       : logic<32>;
        bus.araddr  = addr;
        bus.arvalid = 1;
        for _i in 0..600 {
            if bus.arready {
                break;
            }
            clk.next(1);
        }
        from = ticks;
        clk.next(1);
        bus.arvalid = 0;
        for _i in 0..600 {
            if bus.rvalid {
                break;
            }
            clk.next(1);
        }
        waited = ticks - from;
        data   = bus.rdata;
        clk.next(1);
        return data;
    }

    var good : logic    ;
    var beats: logic<32>;
    var took : logic<32>;

    /// Issues `n` reads back to back without waiting, then takes the beats.
    /// `took` is the cycles from the first address to the last beat.
    function burst (
        n: input logic<32>,
    ) {
        var from : logic<32>;
        good  = 1;
        beats = 0;
        from  = ticks;
        for i in 0..8 {
            if i <: n {
                bus.araddr  = (i * 4) as 32;
                bus.arvalid = 1;
                for _j in 0..600 {
                    if bus.arready {
                        break;
                    }
                    if bus.rvalid {
                        if bus.rdata != 32'h100 + (beats * 4) {
                            good = 0;
                        }
                        beats = beats + 1;
                    }
                    clk.next(1);
                }
                if bus.rvalid {
                    if bus.rdata != 32'h100 + (beats * 4) {
                        good = 0;
                    }
                    beats = beats + 1;
                }
                clk.next(1);
            }
        }
        bus.arvalid = 0;
        for _i in 0..2000 {
            if beats == n {
                break;
            }
            if bus.rvalid {
                if bus.rdata != 32'h100 + (beats * 4) {
                    good = 0;
                }
                beats = beats + 1;
            }
            clk.next(1);
        }
        took = ticks - from;
    }

    always_comb {
        bus.awsize   = 3'd2;
        bus.awburst  = 2'b01;
        bus.awcache  = 0;
        bus.awprot   = 0;
        bus.awid     = 1;
        bus.awlen    = 0;
        bus.awlock   = 0;
        bus.awqos    = 0;
        bus.awregion = 0;
        bus.awuser   = 0;
        bus.wstrb    = 4'hf;
        bus.wlast    = 1;
        bus.wuser    = 0;
        bus.arsize   = 3'd2;
        bus.arburst  = 2'b01;
        bus.arcache  = 0;
        bus.arprot   = 0;
        bus.arid     = 2;
        bus.arlen    = 0;
        bus.arlock   = 0;
        bus.arqos    = 0;
        bus.arregion = 0;
        bus.aruser   = 0;
        bus.bready   = 1;
        bus.rready   = 1;
    }

    var native: logic<32>;
    var fast  : logic<32>;

    initial {
        bus.awaddr  = 0;
        bus.awvalid = 0;
        bus.wdata   = 0;
        bus.wvalid  = 0;
        bus.araddr  = 0;
        bus.arvalid = 0;
        rd_latency  = 0;
        wr_latency  = 0;
        bw          = 0;
        rst.assert(4);
        clk.next(4);

        // 1. With everything at 0 it passes, a cycle or two later.
        for i in 0..8 {
            put((i * 4) as 32, 32'h100 + ((i * 4) as 32));
        }
        $assert(get(32'h8) == 32'h108);
        native = waited;
        $display("native read: %0d cycles", native);

        // 2. A read answers the read latency after its address.
        rd_latency = 50;
        $assert(get(32'hc) == 32'h10c);
        $display("read latency 50: %0d cycles", waited);
        $assert(waited >= 50 && waited <= 51);

        // 3. A write answers the write latency after its data.
        wr_latency = 40;
        put(32'h1c, 32'h11c);
        $display("write latency 40: %0d cycles", waited);
        $assert(waited >= 40 && waited <= 41);
        $assert(get(32'h1c) == 32'h11c);

        // 4. Reads in flight overlap: eight take about one latency, not eight.
        burst(8);
        $display("8 reads at 50: good=%0d beats=%0d took=%0d", good, beats, took);
        $assert(good && beats == 8);
        $assert(took <: 50 + 30);

        // 5. One byte a cycle and four-byte beats: a beat every four cycles.
        rd_latency = 0;
        burst(8);
        fast = took;
        bw   = 16'h0100;
        burst(8);
        $display("8 reads, no limit: %0d cycles; 1 byte per cycle: %0d", fast, took);
        $assert(good && beats == 8);
        $assert(took >= 28 && took >: fast);
        $display("beats counted: %0d read, %0d written", rd_beats, wr_beats);
        $assert(wr_beats == 9);

        clk.next(4);
        $finish();
    }
}
