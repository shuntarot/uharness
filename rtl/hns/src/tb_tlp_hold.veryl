/// `hns::tlp_hold` never drops `tvalid` in the middle of an output TLP, even
/// when the input TLP has gaps.
///
/// The input drops `tvalid` once every 4 cycles, also inside a TLP. The output
/// drops `tready` once every 8 cycles. Packet lengths cycle through 1 / 9 / 5 / 9
/// beats: MemRd (1 beat), payload 256 (9 beats) and payload 128 (5 beats).
#[test(tlp_hold_sends_whole_packets)]
module test_tlp_hold {
    const NPKT: u32 = 200;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen (clk);

    var i_tdata : logic<256>;
    var i_tlast : logic     ;
    var i_tvalid: logic     ;
    var o_tready: logic     ;
    var o_tdata : logic<256>;
    var o_tlast : logic     ;
    var o_tvalid: logic     ;
    var i_tready: logic     ;
    var gaps_g  : logic<16> ;
    var gaps    : logic<16> ;

    var cyc: logic<16>;

    // Sender.
    var gpkt : logic<16>;
    var gbeat: logic<8> ;
    var gseq : logic<32>;
    var ggap : logic    ;
    var want : logic<16>;

    // Receiver.
    var cpkt : logic<16>;
    var cbeat: logic<8> ;
    var cseq : logic<32>;
    var bad  : logic<16>;
    var holes: logic<16>;

    function plen (
        p: input logic<16>,
    ) -> logic<8> {
        return if p[1:0] == 0 ? 8'd1 : if p[1:0] == 2 ? 8'd5 : 8'd9;
    }

    always_comb {
        i_tvalid = gpkt <: NPKT && cyc[1:0] != 2'b11;
        i_tdata  = {224'h0, gseq};
        i_tlast  = gbeat == plen(gpkt) - 1;
        i_tready = cyc[2:0] != 3'b101;
    }

    inst u_hold: tlp_hold #(
        DEPTH : 64,
        USER_W: 60,
    ) (
        i_clk      : clk     ,
        i_rst      : rst     ,
        i_tdata    : i_tdata ,
        i_tkeep    : '1      ,
        i_tlast    : i_tlast ,
        i_tuser    : '0      ,
        i_tvalid   : i_tvalid,
        o_tready   : o_tready,
        o_tdata    : o_tdata ,
        o_tkeep    : _       ,
        o_tlast    : o_tlast ,
        o_tuser    : _       ,
        o_tvalid   : o_tvalid,
        i_tready   : i_tready,
        o_gaps_gray: gaps_g  ,
    );

    inst u_bin: $std::gray_decoder #(
        WIDTH: 16,
    ) (
        i_gray: gaps_g,
        o_bin : gaps  ,
    );

    always_ff (clk, rst) {
        if_reset {
            cyc   = 0;
            gpkt  = 0;
            gbeat = 0;
            gseq  = 0;
            ggap  = 0;
            want  = 0;
            cpkt  = 0;
            cbeat = 0;
            cseq  = 0;
            bad   = 0;
            holes = 0;
        } else {
            cyc = cyc + 1;

            // Sender: count the TLPs that dropped `tvalid` in the middle.
            if i_tvalid && o_tready {
                gseq = gseq + 1;
                if i_tlast {
                    if ggap {
                        want = want + 1;
                    }
                    ggap  = 0;
                    gbeat = 0;
                    gpkt  = gpkt + 1;
                } else {
                    gbeat = gbeat + 1;
                }
            } else if !i_tvalid && gbeat != 0 {
                ggap = 1;
            }

            // Receiver: `o_tvalid` low in the middle of a TLP is a hole.
            if cbeat != 0 && !o_tvalid {
                holes = holes + 1;
            }
            if o_tvalid && i_tready {
                if o_tdata[31:0] != cseq || o_tlast != (cbeat == plen(cpkt) - 1) {
                    bad = bad + 1;
                }
                cseq = cseq + 1;
                if o_tlast {
                    cbeat = 0;
                    cpkt  = cpkt + 1;
                } else {
                    cbeat = cbeat + 1;
                }
            }
        }
    }

    initial {
        rst.assert(4);
        clk.next(4000);
        $display("sent %d packets, received %d, bad beats %d, holes %d, gaps %d (expected %d)", gpkt, cpkt, bad, holes, gaps, want);
        $assert(gpkt == NPKT, "the bench did not send every packet");
        $assert(cpkt == NPKT, "tlp_hold did not deliver every packet");
        $assert(bad == 0, "a beat or its tlast came out wrong");
        $assert(holes == 0, "tlp_hold let tvalid fall in the middle of a packet");
        $assert(want != 0, "the bench never put a gap inside a packet");
        $assert(gaps == want, "o_gaps_gray does not count the packets that had a gap");
        $finish();
    }
}
