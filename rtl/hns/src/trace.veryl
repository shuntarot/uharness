/// A ring of the records a DUT stream carries: an execution trace, for one.
///
/// While `i_run` is high, each beat writes one record into the next entry,
/// and once the ring is full the oldest entry is overwritten. A record is the
/// payload with the cycle count since the start below it. A rise of `i_run`
/// starts over: the count, the cycle count and the write pointer return to 0.
///
/// While `i_pause` is high, beats are not recorded, but the cycle count goes
/// on, so the gap shows when recording resumes. A debugger pauses it while a
/// CPU is halted: the instructions it injects then are its own, not the
/// program's.
///
/// With `i_arm`, a beat whose `i_tdata` matches `i_tvalue` on the bits of
/// `i_tmask` is the trigger. It is recorded, then `i_after` more, and then
/// the ring freezes, so it holds what led up to the trigger and what came
/// right after. `o_hit_at` is the trigger's record number. `i_tdata` is the
/// part of the payload that may trigger; with a mask of 0, the first beat
/// does.
///
/// The host reads the ring through port B, one cycle. `o_count` and
/// `o_wrapped` tell it where the oldest record is. The stream is never
/// stalled: a DUT that has no `ready` cannot wait, and the ring always has
/// room.
pub module trace #(
    param WIDTH : u32 = 32  ,
    param TWIDTH: u32 = 1   ,
    param DEPTH : u32 = 1024,
) (
    i_clk    : input  clock               ,
    i_rst    : input  reset               ,
    i_run    : input  logic               ,
    i_pause  : input  logic               ,
    i_valid  : input  logic               ,
    i_data   : input  logic<WIDTH>        ,
    i_tdata  : input  logic<TWIDTH>       ,
    i_arm    : input  logic               ,
    i_tmask  : input  logic<TWIDTH>       ,
    i_tvalue : input  logic<TWIDTH>       ,
    i_after  : input  logic<32>           ,
    o_count  : output logic<32>           ,
    o_wrapped: output logic               ,
    o_hit    : output logic               ,
    o_hit_at : output logic<32>           ,
    i_haddr  : input  logic<$clog2(DEPTH)>,
    o_hrdata : output logic<WIDTH + 32>   ,
) {
    const INDEX_W: u32 = $clog2(DEPTH);

    var mem    : logic<WIDTH + 32> [DEPTH];
    var running: logic                    ;
    var cycle  : logic<32>                ;
    var count  : logic<32>                ;
    var wrapped: logic                    ;
    var hit    : logic                    ;
    var hit_at : logic<32>                ;
    var left   : logic<32>                ;

    // The beat, one cycle late. The comparison below then starts from a
    // flip-flop, not from the DUT's own logic.
    var valid_q: logic        ;
    var data_q : logic<WIDTH> ;
    var tdata_q: logic<TWIDTH>;

    let frozen: logic          = hit & (left == 0);
    let start : logic          = i_run & ~running;
    let take  : logic          = running & i_run & ~i_pause & valid_q & ~frozen;
    let equal : logic          = ((tdata_q ^ i_tvalue) & i_tmask) == 0;
    let fire  : logic          = take & i_arm & ~hit & equal;
    let wp    : logic<INDEX_W> = count[INDEX_W - 1:0];

    always_ff {
        if_reset {
            valid_q = 0;
            data_q  = 0;
            tdata_q = 0;
            running = 0;
            cycle   = 0;
            count   = 0;
            wrapped = 0;
            hit     = 0;
            hit_at  = 0;
            left    = 0;
        } else {
            valid_q = i_valid;
            data_q  = i_data;
            tdata_q = i_tdata;
            running = i_run;
            if start {
                cycle   = 0;
                count   = 0;
                wrapped = 0;
                hit     = 0;
                hit_at  = 0;
                left    = 0;
            } else if running {
                cycle = cycle + 1;
                if take {
                    count = count + 1;
                    // The count itself wraps at 2^32, so it cannot tell a
                    // full ring from a short one.
                    if wp == DEPTH - 1 {
                        wrapped = 1;
                    }
                    if fire {
                        hit    = 1;
                        hit_at = count;
                        left   = i_after;
                    } else if hit {
                        left = left - 1;
                    }
                }
            }
        }
    }

    // The vendor's RAM template: a bare write under its enable and a bare
    // read. Anything more and Vivado stops inferring a block RAM.
    var hrdata: logic<WIDTH + 32>;
    always_ff {
        if take {
            mem[wp] = {data_q, cycle};
        }
        hrdata = mem[i_haddr];
    }

    assign o_count   = count;
    assign o_wrapped = wrapped;
    assign o_hit     = hit;
    assign o_hit_at  = hit_at;
    assign o_hrdata  = hrdata;
}
